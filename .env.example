################################################################################
# Telegram API credentials (from https://my.telegram.org/apps)
################################################################################
API_ID=your_api_id
API_HASH=your_api_hash

################################################################################
# User-bot login (GramJS)
################################################################################
PHONE_NUMBER=+34xxxxxxxxx  # Use E.164 international format

################################################################################
# Bot API credentials (Telegraf poster)
################################################################################
TELEGRAM_BOT_TOKEN=your_bot_token

# Optional: Two-factor auth password for Telegram user account (if enabled)
TG_2FA_PASSWORD=

################################################################################
# Replication routing
################################################################################
# TG_SOURCE_CHANNEL: comma-separated list of source @usernames or -100<channelId>
TG_SOURCE_CHANNEL=source_channel_a,source_channel_b

# TG_TARGETS: comma-separated list of target chat IDs
TG_TARGETS=-100xxxxxxxxxx,-100xxxxxxxxxx

################################################################################
# Optional filtering
################################################################################

# FILTER_REGEX: Only forward messages matching this pattern (case-insensitive)
# Default: tech|technology|announcement|news|update
# Examples:
#   Crypto: bitcoin|ethereum|crypto|blockchain|BTC|ETH
#   Custom: yourcompany|#yourhashtag|specific.*pattern
# FILTER_REGEX=tech|technology|announcement|news|update

# STRIP_REGEX: Remove matching patterns from message text
# Default: (?:^|\n)Powered by.*$
# Examples:
#   Sponsored: (?:^|\n)Sponsored by.*$
#   Attribution: (?:^|\n)—+\s*@\w+$
# STRIP_REGEX=(?:^|\n)Powered by.*$

################################################################################
# Optional system settings
################################################################################

# Maximum media size in bytes (default: 10485760 = 10MB)
MAX_MEDIA_BYTES=10485760

# SUPPORTED_MEDIA_TYPES: Comma-separated list of media types to forward
# Valid types: photo, document, video, audio (default: photo,document)
# Examples:
#   All media types: photo,document,video,audio
#   Photos and videos only: photo,video
# SUPPORTED_MEDIA_TYPES=photo,document

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

################################################################################
# Deployment
################################################################################
DEPLOY_TARGET=user@host
DEPLOY_DEST=/srv/telegram-replicator
